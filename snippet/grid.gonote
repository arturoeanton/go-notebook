// ShowGrid renders an interactive, server-side data grid:
// click a header to sort, type to filter, page with ‹ ›.
import (
	"fmt"

	pd "github.com/arturoeanton/go-pandas"
)

recs := []map[string]any{}
groups := []string{"alpha", "beta", "gamma"}
for i := 1; i <= 80; i++ {
	recs = append(recs, map[string]any{
		"id":    i,
		"name":  fmt.Sprintf("item-%03d", i),
		"score": float64((i*37)%100) + float64(i%7)/10,
		"group": groups[i%3],
	})
}
df, err := pd.DataFrameFromRecords(recs, pd.WithColumnOrder("id", "name", "score", "group"))
if err != nil {
	panic(err)
}

ShowGrid(df)
